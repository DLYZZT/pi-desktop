#define VS_VERSION_INFO 1
#define VOS_NT_WINDOWS32 0x00040004L
#define VFT_APP 0x00000001L
#define VFT2_UNKNOWN 0x00000000L
#define VS_FFI_FILEFLAGSMASK 0x0000003FL
#define RT_MANIFEST 24

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSION_TUPLE@
 PRODUCTVERSION @VERSION_TUPLE@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "dlyzzt\0"
      VALUE "FileDescription", "Pi Desktop managed process helper\0"
      VALUE "FileVersion", "@VERSION_STRING@\0"
      VALUE "InternalName", "pi-managed-process-helper\0"
      VALUE "LegalCopyright", "Copyright dlyzzt contributors\0"
      VALUE "OriginalFilename", "pi-managed-process-helper.exe\0"
      VALUE "ProductName", "Pi Agent Desktop\0"
      VALUE "ProductVersion", "@VERSION_STRING@\0"
      VALUE "BuildId", "@BUILD_ID@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

1 RT_MANIFEST "@MANIFEST_PATH@"
